[app]
title = SecureShield VPN
package.name = secureshieldvpn
package.domain = org.secureshield
source.include_exts = py,png,jpg,kv,atlas
version = 1.0
requirements = python3,kivy,certifi,openssl,urllib3,idna,charset_normalizer,requests
orientation = portrait
osx.python_version = 3
osx.kivy_version = 1.9.1
fullscreen = 0
android.permissions = INTERNET,ACCESS_NETWORK_STATE
android.api = 33
android.minapi = 21
android.sdk = 31
android.ndk = 25b
android.archs = arm64-v8a,armeabi-v7a
